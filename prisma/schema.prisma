generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  CONTENT_MANAGER
  ADMIN
}

enum ContentType {
  DONGHUA
  ANIME
  FILM
  OVA
  ONA
}

enum ContentStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String
  avatar         String?
  role           Role     @default(USER)
  banned         Boolean  @default(false)
  locale         String   @default("fr")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  favorites        Favorite[]
  watchHistory     WatchHistory[]
  playbackProgress PlaybackProgress[]
}

model Content {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  titleAlt      String?
  description   String?
  coverImage    String?
  bannerImage   String?
  type          ContentType   @default(DONGHUA)
  status        ContentStatus @default(ONGOING)
  year          Int?
  totalEpisodes Int?
  featured      Boolean       @default(false)
  visible       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  genres       ContentGenre[]
  episodes     Episode[]
  favorites    Favorite[]
  watchHistory WatchHistory[]

  @@index([type, status])
  @@index([visible, featured])
  @@index([title])
}

model Genre {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  contents ContentGenre[]
}

model ContentGenre {
  contentId String
  genreId   String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
}

model Episode {
  id        String   @id @default(cuid())
  contentId String
  number    Int
  title     String?
  odyseeUrl String
  thumbnail String?
  duration  Int?
  createdAt DateTime @default(now())

  content          Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  watchHistory     WatchHistory[]
  playbackProgress PlaybackProgress[]

  @@unique([contentId, number])
  @@index([contentId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  episodeId String
  watchedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, watchedAt])
}

model PlaybackProgress {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  progress  Int      @default(0)
  duration  Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, updatedAt])
}
